# fastlane-Konfiguration fuer den GitHub-Browser-Build von HealthWake.
# Uebernommen aus HeJuNo/nightscout-remote, Aufbau angelehnt an
# LoopKit/LoopWorkspace, reduziert auf ein einziges App-Target.
#
# Unterschied zum Schwesterprojekt: HealthWake braucht die
# HealthKit-Capability auf der Bundle-ID. Siehe Lane :identifiers.

require "base64"

default_platform(:ios)

TEAMID                  = ENV["TEAMID"]
GH_PAT                  = ENV["GH_PAT"]
GITHUB_WORKSPACE        = ENV["GITHUB_WORKSPACE"] || File.expand_path("..", __dir__)
GITHUB_REPOSITORY_OWNER = ENV["GITHUB_REPOSITORY_OWNER"]
FASTLANE_KEY_ID         = ENV["FASTLANE_KEY_ID"]
FASTLANE_ISSUER_ID      = ENV["FASTLANE_ISSUER_ID"]
FASTLANE_KEY            = ENV["FASTLANE_KEY"]

# Bundle-ID: Repository-Variable BUNDLE_ID oder com.<TEAMID>.healthwake
BUNDLE_ID = (ENV["BUNDLE_ID"].to_s.strip.empty? ? "com.#{TEAMID}.healthwake" : ENV["BUNDLE_ID"].strip)
APP_NAME  = "HealthWake"
TARGET    = "HealthWake"
PROJECT   = "#{GITHUB_WORKSPACE}/HealthWake.xcodeproj"

ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"

# Capabilities, die die Bundle-ID bei Apple braucht.
#
# Nur HEALTHKIT. Bewusst NICHT dabei:
#   * PUSH_NOTIFICATIONS -- lokale Notifications brauchen keine Capability,
#     nur die Zustimmung des Nutzers zur Laufzeit.
#   * Eine eigene Capability fuer die Hintergrundzustellung gibt es nicht.
#     com.apple.developer.healthkit.background-delivery ist ein reines
#     Entitlement in der App und wird mit HEALTHKIT gewaehrt. Dieselbe
#     Aufteilung nutzt Loop (App-ID nur HEALTHKIT, Entitlements-Datei mit
#     healthkit, healthkit.access und healthkit.background-delivery).
APP_CAPABILITIES = [
  Spaceship::ConnectAPI::BundleIdCapability::Type::HEALTHKIT
].freeze

def asc_api_key
  app_store_connect_api_key(
    key_id: FASTLANE_KEY_ID,
    issuer_id: FASTLANE_ISSUER_ID,
    key_content: FASTLANE_KEY
  )
end

def match_auth
  Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}")
end

# Bundle-ID anlegen, falls sie fehlt, und fehlende Capabilities ergaenzen.
# Idempotent: mehrfaches Ausfuehren aendert nichts, ergaenzt aber eine
# Capability, die bei einer schon bestehenden Bundle-ID noch fehlt.
def configure_bundle_id(name, identifier, capabilities)
  bundle_id = Spaceship::ConnectAPI::BundleId.find(identifier)

  if bundle_id
    UI.success("Bundle-ID #{identifier} existiert bereits.")
  else
    bundle_id = Spaceship::ConnectAPI::BundleId.create(
      name: name,
      identifier: identifier,
      platform: "IOS"
    )
    UI.success("Bundle-ID #{identifier} wurde angelegt.")
  end

  existing = bundle_id.get_capabilities.map(&:capability_type)
  missing  = capabilities.reject { |cap| existing.include?(cap) }

  if missing.empty?
    UI.success("Alle benoetigten Capabilities sind gesetzt: #{capabilities.join(', ')}")
  else
    missing.each do |cap|
      bundle_id.create_capability(cap)
      UI.success("Capability #{cap} ergaenzt.")
    end
    UI.important("Capabilities geaendert -- Lane :certs erneut laufen lassen, " \
                 "damit das Provisioning-Profil die neuen Entitlements enthaelt.")
  end

  bundle_id
end

platform :ios do

  desc "Bundle-ID bei Apple anlegen und HealthKit-Capability setzen"
  lane :identifiers do
    setup_ci if ENV["CI"]
    asc_api_key

    configure_bundle_id(APP_NAME, BUNDLE_ID, APP_CAPABILITIES)
  end

  desc "Distribution-Zertifikat und App-Store-Profil erstellen/aktualisieren"
  lane :certs do
    setup_ci if ENV["CI"]
    ENV["MATCH_READONLY"] = false.to_s
    asc_api_key

    match(
      type: "appstore",
      force: false,
      verbose: true,
      git_basic_authorization: match_auth,
      app_identifier: [BUNDLE_ID]
    )
  end

  desc "Secrets pruefen (Apple-API-Zugang und Entschluesselung von Match-Secrets)"
  lane :validate_secrets do
    setup_ci if ENV["CI"]
    ENV["MATCH_READONLY"] = true.to_s
    asc_api_key

    Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)

    match(
      type: "appstore",
      git_basic_authorization: match_auth,
      app_identifier: []
    )
  end

  desc "Alle Distribution-Zertifikate und Profile widerrufen (nur bei Bedarf)"
  lane :nuke_certs do
    setup_ci if ENV["CI"]
    ENV["MATCH_READONLY"] = false.to_s
    asc_api_key

    match_nuke(
      type: "appstore",
      team_id: TEAMID,
      skip_confirmation: true,
      git_basic_authorization: match_auth
    )
  end

  desc "Pruefen, ob ein gueltiges Distribution-Zertifikat existiert"
  lane :check_and_renew_certificates do
    setup_ci if ENV["CI"]
    asc_api_key

    certificates = Spaceship::ConnectAPI::Certificate.all
    distribution = certificates.select { |c| c.certificate_type == "DISTRIBUTION" }

    needed = distribution.empty? || distribution.all? { |c| Time.parse(c.expiration_date) < Time.now }
    distribution.each do |c|
      UI.message("Distribution-Zertifikat #{c.id}, gueltig bis #{c.expiration_date}")
    end

    file_path = File.expand_path("new_certificate_needed.txt")
    File.write(file_path, needed ? "true" : "false")
    UI.message("Neues Zertifikat noetig: #{needed}")
  end

  desc "Signierte IPA bauen"
  lane :build do
    setup_ci if ENV["CI"]
    api_key = asc_api_key

    previous = latest_testflight_build_number(
      app_identifier: BUNDLE_ID,
      api_key: api_key,
      initial_build_number: 0
    )
    build_number = previous + 1
    UI.message("Build-Nummer: #{build_number}")

    match(
      type: "appstore",
      readonly: true,
      git_basic_authorization: match_auth,
      app_identifier: [BUNDLE_ID]
    )

    mapping = Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    profile_name = mapping[BUNDLE_ID]

    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      team_id: TEAMID,
      bundle_identifier: BUNDLE_ID,
      profile_name: profile_name,
      code_sign_identity: "iPhone Distribution",
      targets: [TARGET]
    )

    xcargs = "CURRENT_PROJECT_VERSION=#{build_number}"
    app_version = ENV["APP_VERSION"].to_s.strip
    xcargs += " MARKETING_VERSION=#{app_version}" unless app_version.empty?

    build_app(
      project: PROJECT,
      scheme: TARGET,
      configuration: "Release",
      export_method: "app-store",
      output_name: "HealthWake.ipa",
      destination: "generic/platform=iOS",
      buildlog_path: "buildlog",
      xcargs: xcargs,
      export_options: {
        provisioningProfiles: { BUNDLE_ID => profile_name }
      }
    )

    copy_artifacts(
      target_path: "artifacts",
      artifacts: ["*.mobileprovision", "*.ipa", "*.dSYM.zip"]
    )
  end

  desc "IPA zu TestFlight hochladen"
  lane :release do
    api_key = asc_api_key

    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      ipa: "HealthWake.ipa",
      skip_submission: false,
      skip_waiting_for_build_processing: true
    )
  end
end
